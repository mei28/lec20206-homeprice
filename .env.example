# Copy to .env (gitignored). `just` loads it for every recipe.
COMP=titanic
SUBMIT_MODE=csv
KAGGLE_USERNAME=
TRACKER=none
# Token for the nvidia-kaggle plugin. `just kaggle-token` fills it from the Kaggle OAuth login
# (valid a few hours); a long-lived token from https://www.kaggle.com/settings/api also works.
KAGGLE_API_TOKEN=
